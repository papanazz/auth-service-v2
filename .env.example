# =====================================================
# Auth Service — environment template
# =====================================================
#
#   cp .env.example .env
#
# These values target the stack in deployments/docker-compose.yml as seen
# FROM THE HOST, which is what `make run`, `make migrate-up`, and psql use.
#
# The api container does not read this file: docker-compose.yml sets its own
# environment using service names (postgres:5432, redis:6379). Only host-side
# tooling consumes .env.
#
# Every key below is read by internal/platform/config. Keys marked REQUIRED
# have no default and the service refuses to start without them.
#
# =====================================================


# -----------------------------------------------------
# Required
# -----------------------------------------------------

# REQUIRED. Host port must match the postgres port published in
# deployments/docker-compose.yml (currently 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_system?sslmode=disable

# REQUIRED. Signs access tokens. Generate a real one per environment:
#   openssl rand -base64 48
JWT_SECRET_KEY=replace-me-with-a-generated-secret


# -----------------------------------------------------
# Application
# -----------------------------------------------------

APP_NAME=auth-service
APP_ENV=development
LOG_LEVEL=debug


# -----------------------------------------------------
# HTTP
# -----------------------------------------------------

HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# Reserved for the gRPC transport listed under Roadmap in README.md.
# Read by config today, but nothing binds it yet.
GRPC_PORT=9090


# -----------------------------------------------------
# Database pool
# -----------------------------------------------------

DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m


# -----------------------------------------------------
# Redis
# -----------------------------------------------------

REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNECTIONS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m


# -----------------------------------------------------
# Token and session lifetimes
# -----------------------------------------------------
#
# Config.Validate enforces two invariants at startup:
#
#   JWT_TTL      <= REFRESH_TOKEN_TTL
#   SESSION_TTL  >= REFRESH_TOKEN_TTL
#
# The second one matters: a refresh token is only honoured while its session
# is still active, so a shorter session silently rejects tokens that have not
# expired yet.

JWT_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_TTL=2160h


# -----------------------------------------------------
# Login rate limiting
# -----------------------------------------------------
#
# Two independent windows: one per client IP, one per credential+IP pair.

LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW=1m
LOGIN_EMAIL_LIMIT=5
LOGIN_EMAIL_WINDOW=15m

# A device may hold at most one active session. A login for a device that
# already has one, within this many minutes of that session's creation, is
# treated as the same client retrying (e.g. after a network timeout) and
# supersedes it. Past this window the login is rejected instead.
LOGIN_DEVICE_GRACE_PERIOD=5m


# -----------------------------------------------------
# Registration rate limiting
# -----------------------------------------------------
#
# Per-IP window. Every attempt counts, not just failures — a validation
# failure or a duplicate-email attempt still counts toward the limit, since
# both are what an account-creation or email-enumeration bot generates in
# bulk.

REGISTER_IP_LIMIT=5
REGISTER_IP_WINDOW=10m


# -----------------------------------------------------
# Idempotency
# -----------------------------------------------------
#
# POST /v1/auth/login requires an Idempotency-Key header: replaying the same
# key returns the original response verbatim instead of re-running the
# request, so a client retry after a dropped connection can never create a
# second session or duplicate any other side effect. Required rather than
# opt-in because there are no deployed clients yet to keep compatible with —
# see the required parameter on middleware.Idempotency to relax this later.
# How long a completed response stays replayable for its key.

IDEMPOTENCY_KEY_TTL=10m


# -----------------------------------------------------
# Observability
# -----------------------------------------------------

# Jaeger OTLP gRPC receiver, published by docker-compose.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
